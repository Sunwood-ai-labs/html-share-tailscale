# Copy this file to .env. Keep real Tailnet names and URLs out of Git.
# The repository ignores .env and .env.* files.

HTML_SHARE_PUBLIC_URL=https://your-device.example.ts.net:9222
HTML_SHARE_TAILSCALE_HOSTNAME=your-device.example.ts.net
HTML_SHARE_TAILSCALE_HTTPS_PORT=9222

# Optional overrides. Values in this file take precedence over the YAML config.
# HTML_SHARE_SERVER_PORT=4311
# HTML_SHARE_CONTENT_ROOTS=examples
# HTML_SHARE_DATA_DIR=.html-share/data
# HTML_SHARE_SITE_DIR=.html-share/site
# HTML_SHARE_CONFIG=./html-share.config.yaml
