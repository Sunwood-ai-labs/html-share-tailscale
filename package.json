{
  "name": "html-share-tailscale",
  "version": "0.1.0",
  "description": "Tailnet-only HTML dashboard for Claude Code and Codex results",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Sunwood AI Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sunwood-ai-labs/html-share-tailscale.git"
  },
  "homepage": "https://github.com/Sunwood-ai-labs/html-share-tailscale#readme",
  "bugs": "https://github.com/Sunwood-ai-labs/html-share-tailscale/issues",
  "keywords": [
    "claude-code",
    "codex",
    "tailscale",
    "tailnet",
    "mobile",
    "review"
  ],
  "bin": {
    "html-share": "./dist/src/cli.js"
  },
  "files": [
    "dist/",
    "web/",
    "skills/",
    ".codex-plugin/",
    ".env.example",
    "html-share.config.example.yaml",
    "README.md",
    "README.ja.md",
    "assets/",
    "docs/",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate:skill": "node scripts/validate-skill.mjs skills/mobile skills/create-html skills/inbox",
    "validate:plugin": "node scripts/validate-plugin.mjs .",
    "security:scan": "node scripts/security-scan.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check && npm test && npm run validate:skill && npm run validate:plugin && npm run security:scan && npm run audit:prod",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "local:serve": "tsx src/cli.ts serve",
    "serve": "node dist/src/cli.js serve",
    "tailscale:serve": "node dist/src/cli.js tailscale serve"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=22"
  }
}
